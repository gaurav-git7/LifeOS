# Copy to backend/.env for local development. Never commit the real .env.
# Production values go into Render → Environment. See docs/SETUP.md.

APP_ENV=development

# Local default is SQLite (zero setup). For Supabase use the *session pooler* URL:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./lifeos_dev.db
DB_SCHEMA=app

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JOB_SECRET=change-me-too
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REGISTRATION_MODE=open           # production: invite (first account is always allowed + becomes admin)
PUBLIC_APP_URL=http://localhost:8000

# Gemini (leave empty to use the built-in fake assistant)
GEMINI_API_KEY=
GEMINI_MODEL_LITE=gemini-2.5-flash-lite
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
AI_DAILY_BUDGET_USD=0.10

# Firebase Cloud Messaging: service-account JSON (raw or base64). Empty = push disabled.
FIREBASE_CREDENTIALS_JSON=

# Email: console (prints to logs) | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=LifeOS <onboarding@resend.dev>
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

RATE_LIMIT_ENABLED=true
